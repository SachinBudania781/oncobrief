{
  "name": "oncobrief-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "prebuild": "node scripts/copy-swagger.mjs",
    "predev": "node scripts/copy-swagger.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:patient": "node scripts/build-apps.mjs patient",
    "build:doctor": "node scripts/build-apps.mjs doctor",
    "build:staff": "node scripts/build-apps.mjs staff",
    "build:hub": "node scripts/build-apps.mjs hub",
    "build:apps": "node scripts/build-apps.mjs all",
    "preview": "vite preview",
    "test": "node --test tests/wearablePackets.test.mjs",
    "test:e2e": "playwright test",
    "test:components": "node tests/transport-browser.cjs && node memory-up/tests/browser.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^5.0.0",
    "swagger-ui-dist": "^5.29.0",
    "vite": "^7.3.0"
  }
}
