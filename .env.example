# Copy to .env (never commit .env). Without a key the brief is written by the deterministic engine.
LLM_PROVIDER=none          # gemini | anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=                 # e.g. gemini-2.5-flash, claude-haiku-4-5-20251001, gpt-4o-mini
LLM_BASE_URL=              # only for OpenAI-compatible hosts such as Groq
