# Copy to backend/.env for local development. Replace placeholders; never commit backend/.env.
# DEMO_MODE=true creates FABRICATED patients and published demo sign-ins.
DEMO_MODE=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
SESSION_MINUTES=30
DATA_DIR=./data
# Production: persistent storage in an India region; set DEMO_MODE=false, COOKIE_SECURE=true.
DATABASE_URL=
INDIA_HOSTING_CONFIRMED=false
# REQUIRED in production: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
FILE_SIGNING_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# REQUIRED in production: python -c "import pyotp; print(pyotp.random_base32())"
BOOTSTRAP_ADMIN_TOTP_SECRET=
HOSPITAL_NAME=OncoBrief Demo Cancer Centre
HOSPITAL_ADDRESS=
PUBLIC_BASE_URL=
HOSPITAL_EMERGENCY_PHONE=
# Optional local Windows OCR executable; Docker includes Tesseract.
TESSERACT_CMD=
# Optional cited briefs, record answers and report explanations. One shared backend key.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_DATA_PROCESSING_APPROVED=false
COHORT_ANALYTICS_CONSENT=false
# External adapters: HTTPS JSON endpoints you own, using contracts in docs/INTEGRATIONS.md.
# Raw vendor keys alone are insufficient: the named adapter must implement the contract.
SMS_ADAPTER_URL=
SMS_ADAPTER_KEY=
WHATSAPP_ADAPTER_URL=
WHATSAPP_ADAPTER_KEY=
TELEPHONY_ADAPTER_URL=
TELEPHONY_ADAPTER_KEY=
BHASHINI_ADAPTER_URL=
BHASHINI_API_KEY=
TRANSLATION_ADAPTER_URL=
TRANSLATION_API_KEY=
CTRI_ADAPTER_URL=
CTRI_API_KEY=
JAN_AUSHADHI_ADAPTER_URL=
JAN_AUSHADHI_API_KEY=
ENVIRONMENT_ADAPTER_URL=
ENVIRONMENT_API_KEY=
VISION_ADAPTER_URL=
VISION_API_KEY=
WEARABLE_ADAPTER_URL=
WEARABLE_API_KEY=
TELEMEDICINE_ADAPTER_URL=
TELEMEDICINE_API_KEY=
ER_ALERT_ADAPTER_URL=
ER_ALERT_ADAPTER_KEY=
FORMULARY_ADAPTER_URL=
FORMULARY_ADAPTER_KEY=
EVIDENCE_ADAPTER_URL=
EVIDENCE_ADAPTER_KEY=
# Local JSON list of hospital-verified survivor volunteers; sample schema is in docs/INTEGRATIONS.md.
BUDDY_DIRECTORY_PATH=
AUDIT_ANCHOR_ADAPTER_URL=
AUDIT_ANCHOR_ADAPTER_KEY=
